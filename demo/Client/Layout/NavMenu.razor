<nav class="site-nav" id="@Id" aria-label="Main">
    @foreach (var group in Links.GroupBy(l => l.Group))
    {
        <h2 class="nav-group" id="nav-@Slug(group.Key)">@group.Key</h2>
        <ul aria-labelledby="nav-@Slug(group.Key)">
            @foreach (var link in group)
            {
                <li><NavLink href="@link.Href" Match="NavLinkMatch.All">@link.Title</NavLink></li>
            }
        </ul>
    }
</nav>

@code {
    [Parameter] public string? Id { get; set; }

    public sealed record Link(string Group, string Title, string Href);

    public static readonly IReadOnlyList<Link> Links =
    [
        new("Start here", "Introduction", ""),
        new("Start here", "Guided tour", "tour"),
        new("Start here", "Showcase app", "showcase"),
        new("Design tokens", "Token explorer", "tokens"),
        new("Design tokens", "Validation", "validation"),
        new("Design tokens", "Compare themes", "compare"),
        new("Design tokens", "Coverage", "coverage"),
        new("Design tokens", "Import and export", "import-export"),
        new("Design tokens", "Integrations", "integrations"),
        new("Theming", "Themes and brands", "themes"),
        new("Theming", "Brand builder", "brand-builder"),
        new("Theming", "Live editor", "editor"),
        new("Primitives", "Overview and skins", "primitives"),
        new("Primitives", "Buttons and toggles", "primitives/controls"),
        new("Primitives", "Forms", "primitives/forms"),
        new("Primitives", "Tabs", "primitives/tabs"),
        new("Primitives", "Disclosure and accordion", "primitives/disclosure"),
        new("Primitives", "Dialog", "primitives/dialog"),
        new("Primitives", "Popover and tooltip", "primitives/popover"),
        new("Primitives", "Listbox, select, combobox", "primitives/listbox"),
        new("Primitives", "Menu, submenus, menubar", "primitives/menu"),
        new("Primitives", "Slider, number field, date picker", "primitives/inputs"),
        new("Primitives", "Tree view", "primitives/tree"),
        new("Primitives", "Toasts and announcements", "primitives/feedback"),
        new("Guides", "Design system example", "design-system"),
        new("Guides", "Accessibility", "accessibility"),
    ];

    /// <summary>An id-safe form of a group name.</summary>
    public static string Slug(string text) => text.ToLowerInvariant().Replace(' ', '-');
}
