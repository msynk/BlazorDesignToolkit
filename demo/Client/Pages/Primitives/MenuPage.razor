@page "/primitives/menu"

<PageTitle>Menu · BlazorDesignToolkit</PageTitle>

<h1 tabindex="-1">Menu button</h1>
<p class="lead">Menus of actions and options: menu buttons, checkbox and radio items, nested submenus and an
    application-style menubar, with type-ahead and wrapping arrow-key navigation.</p>

<Example Title="Actions menu" Inspect="true" Code="@Code">
    <ChildContent>
        <Menu>
            <MenuTrigger data-testid="menu-trigger">Actions</MenuTrigger>
            <MenuContent class="menu" data-testid="menu">
                <MenuItem TextValue="Rename" OnSelect="@(() => _last = "Rename")">Rename</MenuItem>
                <MenuItem TextValue="Duplicate" OnSelect="@(() => _last = "Duplicate")">Duplicate</MenuItem>
                <MenuItem TextValue="Move" Disabled="true">Move (no permission)</MenuItem>
                <MenuSeparator />
                <MenuCheckboxItem TextValue="Pin" @bind-IsChecked="_pinned">Pinned</MenuCheckboxItem>
                <MenuRadioGroup aria-label="Sort by" @bind-Value="_sort">
                    <MenuRadioItem Value="name" TextValue="Name">Sort by name</MenuRadioItem>
                    <MenuRadioItem Value="date" TextValue="Date">Sort by date</MenuRadioItem>
                </MenuRadioGroup>
                <MenuSeparator />
                <MenuItem TextValue="Delete" OnSelect="@(() => _last = "Delete")">Delete</MenuItem>
            </MenuContent>
        </Menu>
        <p role="status">Last action: @(_last ?? "none") · pinned: @_pinned · sort: @_sort</p>
    </ChildContent>
</Example>

<KeyboardTable Rows="@Keys" />

<Example Title="Submenu" Inspect="true">
    <ChildContent>
        <Menu>
            <MenuTrigger data-testid="submenu-trigger">Share</MenuTrigger>
            <MenuContent data-testid="submenu-root">
                <MenuItem TextValue="Copy link" OnSelect="@(() => _last = "Copy link")">Copy link</MenuItem>
                <MenuSub>
                    <MenuSubTrigger TextValue="Send to" data-testid="send-to">Send to</MenuSubTrigger>
                    <MenuSubContent data-testid="send-to-menu">
                        <MenuItem TextValue="Email" OnSelect="@(() => _last = "Email")">Email</MenuItem>
                        <MenuItem TextValue="Chat" OnSelect="@(() => _last = "Chat")">Chat</MenuItem>
                    </MenuSubContent>
                </MenuSub>
                <MenuItem TextValue="Embed" OnSelect="@(() => _last = "Embed")">Embed</MenuItem>
            </MenuContent>
        </Menu>
        <KeyboardTable Rows="@([("Right / Enter / Space (on Send to)", "Opens the submenu on its first item."), ("Left / Escape (in the submenu)", "Closes the submenu; focus returns to Send to."), ("Enter (on an item)", "Activates it and closes all menus.")])" />
    </ChildContent>
</Example>

<Example Title="Menubar" Inspect="true">
    <ChildContent>
        <Menubar aria-label="Editor" data-testid="menubar">
            <Menu>
                <MenubarTrigger>File</MenubarTrigger>
                <MenuContent>
                    <MenuItem TextValue="New" OnSelect="@(() => _last = "New")">New</MenuItem>
                    <MenuItem TextValue="Open" OnSelect="@(() => _last = "Open")">Open…</MenuItem>
                    <MenuSub>
                        <MenuSubTrigger TextValue="Export">Export</MenuSubTrigger>
                        <MenuSubContent>
                            <MenuItem TextValue="PDF" OnSelect="@(() => _last = "Export PDF")">PDF</MenuItem>
                            <MenuItem TextValue="HTML" OnSelect="@(() => _last = "Export HTML")">HTML</MenuItem>
                        </MenuSubContent>
                    </MenuSub>
                </MenuContent>
            </Menu>
            <Menu>
                <MenubarTrigger>Edit</MenubarTrigger>
                <MenuContent>
                    <MenuItem TextValue="Undo" OnSelect="@(() => _last = "Undo")">Undo</MenuItem>
                    <MenuItem TextValue="Redo" OnSelect="@(() => _last = "Redo")">Redo</MenuItem>
                </MenuContent>
            </Menu>
            <Menu>
                <MenubarTrigger>View</MenubarTrigger>
                <MenuContent>
                    <MenuCheckboxItem TextValue="Ruler" @bind-IsChecked="_ruler">Ruler</MenuCheckboxItem>
                </MenuContent>
            </Menu>
        </Menubar>
        <KeyboardTable Rows="@([("Left / Right", "Moves between menus; while a menu is open, opens the adjacent one."), ("Down / Enter / Space", "Opens the menu on its first item."), ("Up", "Opens the menu on its last item."), ("Home / End", "First or last menu."), ("Escape", "Closes the menu; focus returns to the menubar.")])" />
    </ChildContent>
</Example>

@code {
    private string? _last;
    private bool _pinned;
    private string? _sort = "name";
    private bool _ruler;

    private static readonly IReadOnlyList<(string, string)> Keys =
    [
        ("Enter / Space / Down", "Opens the menu and focuses the first item."),
        ("Up (on the button)", "Opens the menu and focuses the last item."),
        ("Up / Down", "Moves between items, wrapping; disabled items are skipped."),
        ("Home / End", "Moves to the first or last item."),
        ("Type", "Moves to the next item starting with the typed characters."),
        ("Enter / Space", "Activates the item. Checkbox and radio items keep the menu open."),
        ("Escape", "Closes the menu and returns focus to the button."),
        ("Tab", "Closes the menu and moves focus onwards."),
    ];

    private const string Code = """
        <Menu>
            <MenuTrigger>Actions</MenuTrigger>
            <MenuContent>
                <MenuItem TextValue="Rename" OnSelect="Rename">Rename</MenuItem>
                <MenuSeparator />
                <MenuCheckboxItem TextValue="Pin" @bind-IsChecked="pinned">Pinned</MenuCheckboxItem>
            </MenuContent>
        </Menu>
        """;
}
