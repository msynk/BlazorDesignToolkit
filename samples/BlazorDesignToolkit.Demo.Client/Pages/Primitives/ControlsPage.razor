@page "/primitives/controls"

<PageTitle>Buttons and toggles · BlazorDesignToolkit</PageTitle>

<h1 tabindex="-1">Buttons and toggles</h1>
<p>Native elements first: <code>Checkbox</code> and <code>Radio</code> render real inputs; <code>ToggleButton</code> and
    <code>Switch</code> render <code>&lt;button&gt;</code> with the right ARIA state.</p>

<Example Title="Toggle button" Code="@ToggleCode">
    <ChildContent>
        <div class="actions" role="group" aria-label="Text formatting">
            <ToggleButton @bind-Pressed="_bold" data-testid="toggle-bold">Bold</ToggleButton>
            <ToggleButton @bind-Pressed="_italic">Italic</ToggleButton>
        </div>
        <p role="status">Bold is @(_bold ? "on" : "off").</p>
        <KeyboardTable Rows="@([("Enter, Space", "Toggles the pressed state."), ("Tab", "Moves to the next control.")])" />
    </ChildContent>
</Example>

<Example Title="Switch" Code="@SwitchCode">
    <ChildContent>
        <FormField>
            <FormLabel>Email notifications</FormLabel>
            <Switch @bind-Checked="_notifications" data-testid="switch" />
            <FormDescription>Weekly summary of activity.</FormDescription>
        </FormField>
        <KeyboardTable Rows="@([("Space, Enter", "Toggles on and off.")])" />
    </ChildContent>
</Example>

<Example Title="Checkbox with mixed state">
    <ChildContent>
        <fieldset class="stack">
            <legend>Toppings</legend>
            <label><Checkbox Checked="AllSelected" CheckedChanged="SelectAll" Indeterminate="SomeSelected" /> All toppings</label>
            @foreach (var topping in _toppings.Keys.ToList())
            {
                var name = topping;
                <label class="indent"><Checkbox Checked="_toppings[name]" CheckedChanged="v => _toppings[name] = v" /> @name</label>
            }
        </fieldset>
        <KeyboardTable Rows="@([("Space", "Toggles the checkbox.")])" />
    </ChildContent>
</Example>

<Example Title="Radio group">
    <ChildContent>
        <FormField>
            <FormLabel>Plan</FormLabel>
            <RadioGroup TValue="string" @bind-Value="_plan" data-testid="plan">
                <label><Radio Value="@("free")" /> Free</label>
                <label><Radio Value="@("pro")" /> Pro</label>
                <label><Radio Value="@("team")" Disabled="true" /> Team (unavailable)</label>
            </RadioGroup>
        </FormField>
        <p role="status">Selected plan: @_plan</p>
        <KeyboardTable Rows="@([("Tab", "Moves into the group (to the checked radio) and out of it."), ("Arrow keys", "Select the next or previous radio (native behavior)."), ("Space", "Selects the focused radio if none is checked.")])" />
    </ChildContent>
</Example>

@code {
    private bool _bold;
    private bool _italic;
    private bool _notifications = true;
    private string? _plan = "free";
    private readonly Dictionary<string, bool> _toppings = new() { ["Cheese"] = true, ["Olives"] = false, ["Basil"] = false };

    private bool AllSelected => _toppings.Values.All(v => v);
    private bool SomeSelected => _toppings.Values.Any(v => v) && !AllSelected;

    private void SelectAll(bool value)
    {
        foreach (var key in _toppings.Keys.ToList()) _toppings[key] = value;
    }

    private const string ToggleCode = """<ToggleButton @bind-Pressed="bold">Bold</ToggleButton>""";
    private const string SwitchCode = """
        <FormField>
            <FormLabel>Email notifications</FormLabel>
            <Switch @bind-Checked="notifications" />
            <FormDescription>Weekly summary of activity.</FormDescription>
        </FormField>
        """;
}
