@page "/editor"
@using BlazorDesignToolkit.Tokens.Colors
@using BlazorDesignToolkit.Tokens.Json
@using BlazorDesignToolkit.Tokens.Validation
@inject LiveAnnouncer Announcer

<PageTitle>Live token editor · BlazorDesignToolkit</PageTitle>

<h1 tabindex="-1">Live token editor</h1>
<p>Override palette or semantic colors at runtime. Overrides are applied as inline custom properties on the root
    element — only the declarations that actually change are written — and every contrast pair of the design system is
    re-checked immediately.</p>

<div class="editor-grid">
    <Example Title="Override a color">
        <ChildContent>
            <FormField class="control">
                <FormLabel>Token</FormLabel>
                <Combobox TItem="string" Items="ColorTokens" Value="_token" ValueChanged="SelectToken" />
                <FormDescription>Type to search the color tokens.</FormDescription>
            </FormField>
            @if (_token is not null)
            {
                <FormField class="control" Context="field">
                    <FormLabel>New value for @_token</FormLabel>
                    <input type="color" value="@_hex" @onchange="OnColorChanged" @attributes="field.ControlAttributes" />
                    <FormDescription>Current: <code>@_hex</code></FormDescription>
                </FormField>
            }
            <div class="actions">
                <AuroraButton Variant="secondary" OnClick="Clear" Disabled="State.Overrides.IsEmpty">Clear overrides</AuroraButton>
            </div>
            @if (!State.Overrides.IsEmpty)
            {
                <h3>Active overrides</h3>
                <ul>
                    @foreach (var (path, value) in State.Overrides)
                    {
                        <li><code>@path</code> = <code>@value.ToJson()</code></li>
                    }
                </ul>
            }
        </ChildContent>
    </Example>

    <Example Title="Contrast in the current theme">
        <ChildContent>
            <p role="status">@Failures of @Results.Count checks fail.</p>
            <table class="data-table">
                <caption>WCAG 2.2 contrast checks</caption>
                <thead><tr><th scope="col">Foreground</th><th scope="col">Background</th><th scope="col">Ratio</th><th scope="col">Required</th><th scope="col">Result</th></tr></thead>
                <tbody>
                    @foreach (var r in Results)
                    {
                        <tr class="@(r.Passed == false ? "fail" : null)">
                            <th scope="row"><code>@r.Foreground</code></th>
                            <td><code>@r.Background</code></td>
                            <td>@r.RatioText</td>
                            <td>@r.Required:1</td>
                            <td>@(r.Passed switch { true => "Pass", false => "Fail" + (r.SuggestedForeground is { } s ? $" (try {s})" : ""), null => "Unknown: " + r.IndeterminateReason })</td>
                        </tr>
                    }
                </tbody>
            </table>
        </ChildContent>
    </Example>
</div>

@code {
    private string? _token;
    private string _hex = "#000000";
    private int _lastFailures = -1;

    [CascadingParameter] private ThemeManager Manager { get; set; } = default!;
    [CascadingParameter] private ThemeState State { get; set; } = default!;

    private IEnumerable<string> ColorTokens => Manager.Resolve().Tokens.Tokens.Where(t => t.Type == TokenTypes.Color && !t.IsAlias).Select(t => t.Path.ToString());

    private IReadOnlyList<ContrastResult> Results => TokenValidator.Validate(Manager.Resolve().Tokens, DemoTokens.Validation).ContrastResults;

    private int Failures => Results.Count(r => r.Passed == false);

    private void SelectToken(string? token)
    {
        _token = token;
        if (token is not null && Manager.Resolve().Tokens[TokenPath.Parse(token)]?.Value is ColorValue c) _hex = c.ToSrgb().ToHex(false);
    }

    private void OnColorChanged(ChangeEventArgs e)
    {
        if (_token is null || e.Value?.ToString() is not { } hex || !SrgbColor.TryParseHex(hex, out var color)) return;
        _hex = hex;
        Manager.SetOverride(_token, ColorValue.FromSrgb(color).ToSourceNode());
        Announce();
    }

    private void Clear()
    {
        Manager.ClearOverrides();
        Announce();
    }

    private void Announce()
    {
        var failures = Failures;
        if (failures != _lastFailures) Announcer.Announce(failures == 0 ? "All contrast checks pass." : $"{failures} contrast checks fail.");
        _lastFailures = failures;
    }
}
