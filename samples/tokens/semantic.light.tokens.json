{
  "$description": "Aurora semantic color tokens (light mode). Every value aliases a foundation token.",
  "color": {
    "$type": "color",
    "text": {
      "default": {
        "$value": "{color.neutral.900}"
      },
      "muted": {
        "$value": "{color.neutral.600}"
      },
      "inverse": {
        "$value": "{color.neutral.50}"
      },
      "link": {
        "$value": "{color.blue.700}"
      },
      "danger": {
        "$value": "{color.red.700}"
      },
      "success": {
        "$value": "{color.green.700}"
      }
    },
    "surface": {
      "default": {
        "$value": "{color.white}"
      },
      "raised": {
        "$value": "{color.white}"
      },
      "sunken": {
        "$value": "{color.neutral.50}"
      },
      "inverse": {
        "$value": "{color.neutral.900}"
      },
      "accent": {
        "$value": "{color.blue.600}"
      },
      "danger": {
        "$value": "{color.red.600}"
      },
      "success": {
        "$value": "{color.green.700}"
      },
      "warning": {
        "$value": "{color.amber.300}"
      }
    },
    "on-surface": {
      "default": {
        "$value": "{color.text.default}"
      },
      "raised": {
        "$value": "{color.text.default}"
      },
      "sunken": {
        "$value": "{color.text.default}"
      },
      "inverse": {
        "$value": "{color.text.inverse}"
      },
      "accent": {
        "$value": "{color.white}"
      },
      "danger": {
        "$value": "{color.white}"
      },
      "success": {
        "$value": "{color.white}"
      },
      "warning": {
        "$value": "{color.neutral.950}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.neutral.200}",
        "$description": "Decorative separators only; not sufficient for component boundaries."
      },
      "default": {
        "$value": "{color.neutral.500}",
        "$description": "Boundaries of form controls (meets 3:1 against surfaces)."
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.blue.600}"
      }
    },
    "interactive": {
      "hover": {
        "$value": "{color.neutral.100}"
      },
      "selected": {
        "$value": "{color.blue.100}"
      }
    },
    "overlay": {
      "scrim": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.5,
          "hex": "#000000"
        },
        "$description": "Translucent backdrop behind modal dialogs."
      }
    }
  }
}
