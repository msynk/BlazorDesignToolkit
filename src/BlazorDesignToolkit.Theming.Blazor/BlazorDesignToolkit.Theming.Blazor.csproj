<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>BlazorDesignToolkit.Theming.Blazor</RootNamespace>
    <Description>Blazor adapter for BlazorDesignToolkit theming: theme stylesheet and early-initialization components, runtime theme switching through a small isolated JavaScript module, system-preference tracking and optional persistence.</Description>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorDesignToolkit.Theming\BlazorDesignToolkit.Theming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorDesignToolkit.Theming.Tests" />
  </ItemGroup>

</Project>
