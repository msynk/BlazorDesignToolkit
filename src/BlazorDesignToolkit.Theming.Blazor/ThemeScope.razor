@* Applies a different theme (and axis values) to a subtree without JavaScript, for previews or embedded brands.
   All axis attributes are rendered so that the scope does not inherit stale values from ancestors. Overrides are written
   as inline custom properties on the scope element (only the declarations whose values change), so they apply to the
   subtree only. *@
@using BlazorDesignToolkit.Tokens.Diagnostics
@using BlazorDesignToolkit.Tokens.Json
@inject ThemeCatalog Catalog
@inject ThemingOptions Options

<div @attributes="_attributes">@ChildContent</div>

@code {
    private IReadOnlyDictionary<string, object> _attributes = new Dictionary<string, object>();
    // Snapshots of the inputs the override style was computed for, compared by content: a parent that builds new
    // dictionaries on every render (and re-renders when OverrideDiagnostics fires) must not cause another recomputation.
    private bool _computed;
    private string? _computedThemeId;
    private Dictionary<string, string>? _computedAxes;
    private Dictionary<string, SourceNode>? _computedOverrides;
    private bool _reportedDiagnostics;
    private string _overrideStyle = "";

    [Parameter, EditorRequired] public string ThemeId { get; set; } = "";
    /// <summary>Axis values for the scope. Missing axes use their defaults; <c>system</c> is supported.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? Axes { get; set; }
    /// <summary>
    /// Token overrides for this subtree: token path → DTCG <c>$value</c> (for example
    /// <c>["color.brand.primary"] = SourceJsonParser.Parse("{ \"colorSpace\": \"srgb\", \"components\": [1, 0, 0] }").Root</c>).
    /// Invalid overrides are ignored and reported through <see cref="OverrideDiagnostics"/>.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, SourceNode>? Overrides { get; set; }
    /// <summary>Receives the diagnostics of <see cref="Overrides"/> whenever they are recomputed.</summary>
    [Parameter] public EventCallback<IReadOnlyList<Diagnostic>> OverrideDiagnostics { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var style = AdditionalAttributes?.TryGetValue("style", out var s) == true ? s?.ToString() : null;
        IReadOnlyList<Diagnostic>? diagnostics = null;
        if (!_computed || _computedThemeId != ThemeId || !SameAxes(_computedAxes, Axes) || !SameOverrides(_computedOverrides, Overrides))
        {
            _computed = true;
            _computedThemeId = ThemeId;
            _computedAxes = Axes is null ? null : new Dictionary<string, string>(Axes, StringComparer.Ordinal);
            _computedOverrides = Overrides is null ? null : new Dictionary<string, SourceNode>(Overrides, StringComparer.Ordinal);
            _overrideStyle = "";
            if (Overrides is { Count: > 0 })
            {
                var selection = new ThemeSelection(ThemeId, Axes);
                var declarations = ThemeStylesheetGenerator.GetOverrideDeclarations(Catalog, selection, ThemeOverrides.ToTree(Overrides), Options.Css, out var found);
                _overrideStyle = string.Concat(declarations.Select(static d => $"{d.Name}: {d.Value}; "));
                diagnostics = found;
            }
            else if (_reportedDiagnostics)
            {
                // The overrides were removed: clear the diagnostics reported for them.
                diagnostics = [];
            }
        }

        var result = new Dictionary<string, object>(AdditionalAttributes ?? new Dictionary<string, object>(), StringComparer.Ordinal);
        foreach (var (k, v) in ThemeRootAttributes.For(Catalog, new ThemeSelection(ThemeId, Axes), Options.Css)) result[k] = v;
        var combined = (_overrideStyle + (style ?? "")).Trim();
        if (combined.Length > 0) result["style"] = combined;
        else result.Remove("style");
        _attributes = result;

        if (diagnostics is not null && OverrideDiagnostics.HasDelegate)
        {
            _reportedDiagnostics = diagnostics.Count > 0;
            await OverrideDiagnostics.InvokeAsync(diagnostics);
        }
    }

    private static bool SameAxes(IReadOnlyDictionary<string, string>? previous, IReadOnlyDictionary<string, string>? current)
    {
        if (previous is null || current is null) return (previous?.Count ?? 0) == (current?.Count ?? 0);
        if (previous.Count != current.Count) return false;
        foreach (var (key, value) in current)
        {
            if (!previous.TryGetValue(key, out var other) || !string.Equals(value, other, StringComparison.Ordinal)) return false;
        }
        return true;
    }

    private static bool SameOverrides(IReadOnlyDictionary<string, SourceNode>? previous, IReadOnlyDictionary<string, SourceNode>? current)
    {
        if (previous is null || current is null) return (previous?.Count ?? 0) == (current?.Count ?? 0);
        if (previous.Count != current.Count) return false;
        foreach (var (key, value) in current)
        {
            if (!previous.TryGetValue(key, out var other) || !SourceNode.DeepEquals(value, other)) return false;
        }
        return true;
    }
}
