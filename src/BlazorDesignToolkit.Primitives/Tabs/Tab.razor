@namespace BlazorDesignToolkit.Primitives
@* role="tab" button. Only the selected tab is in the tab sequence (roving tabindex). *@
@inherits PrimitiveBase
@implements ICompositeItem

<button type="button" role="tab" @ref="_element"
        @attributes='Attributes("role", "aria-selected", "aria-controls", "tabindex", "id", "type")'
        id="@ElementId"
        aria-selected="@(IsSelected ? "true" : "false")"
        aria-controls="@Context.PanelId(Value)"
        aria-disabled="@(Disabled ? "true" : null)"
        tabindex="@(IsSelected ? "0" : "-1")"
        data-state="@(IsSelected ? "active" : "inactive")"
        data-disabled="@(Disabled ? "" : null)"
        data-orientation="@(Context.Owner.Orientation == Orientation.Vertical ? "vertical" : "horizontal")"
        data-bdt-keys="@(Context.Owner.Activation == Tabs.TabsActivation.Manual ? "Space" : null)"
        @onclick="SelectAsync"
        @onkeydown="OnKeyDownAsync"
        @onfocus="() => Context.Tabs.OnFocus(this)"
        @onblur="() => Context.Tabs.OnBlur(this)">
    @ChildContent
</button>

@code {
    private ElementReference _element;

    [CascadingParameter] internal Tabs.TabsContext Context { get; set; } = default!;
    /// <summary>Key matching a TabPanel's Value.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    /// <summary>Disabled tabs cannot be selected and are skipped by arrow-key navigation.</summary>
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public string ElementId => Context.TabId(Value);
    public bool IsDisabled => Disabled;
    public string? TypeaheadLabel => null;
    private bool IsSelected => Context.Owner.Selected == Value;

    protected override void OnInitialized()
    {
        if (Context is null) throw new InvalidOperationException("Tab must be placed inside Tabs.");
        Context.Tabs.Register(this);
        Track(Context);
    }

    internal ValueTask FocusAsync() => _element.FocusAsync();

    private Task SelectAsync() => Disabled ? Task.CompletedTask : Context.Owner.SelectAsync(Value);

    private Task OnKeyDownAsync(KeyboardEventArgs e)
        => e.Key is "Enter" or " " && Context.Owner.Activation == Tabs.TabsActivation.Manual ? SelectAsync() : Task.CompletedTask;

    public override ValueTask DisposeAsync()
    {
        Context.Tabs.Unregister(this);
        return base.DisposeAsync();
    }
}
