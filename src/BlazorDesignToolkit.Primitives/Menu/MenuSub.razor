@namespace BlazorDesignToolkit.Primitives
@* A submenu (WAI-ARIA Menu pattern): MenuSubTrigger is a menuitem with aria-haspopup="menu" in the parent menu, and
   MenuSubContent is the nested menu. Right arrow, Enter or Space on the trigger opens it with focus on its first item;
   Left arrow or Escape closes it and returns focus to the trigger; activating an item closes every menu up to the root;
   hovering the trigger opens it without moving focus, hovering a sibling item closes it. *@
@implements IMenuOwner
@implements IDisposable

<CascadingValue Value="this" IsFixed="true">
    @* Like the APG examples: the trigger and its menu share a presentational wrapper inside the parent menu. *@
    <div role="none" data-menu-sub="">@ChildContent</div>
</CascadingValue>

@code {
    private bool _open;

    [CascadingParameter] internal Menu.MenuContext Parent { get; set; } = default!;
    [Parameter] public string Placement { get; set; } = "right-start";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal Menu.MenuContext Context { get; } = new();
    internal bool IsOpen => _open;

    bool IMenuOwner.IsOpen => _open;
    string IMenuOwner.Placement => Placement;

    protected override void OnInitialized()
    {
        if (Parent is null) throw new InvalidOperationException("MenuSub must be placed inside MenuContent or MenuSubContent.");
        Context.Owner = this;
        Context.Parent = Parent;
        Context.MenuId = Ids.Next("submenu");
    }

    internal async Task OpenAsync(Menu.MenuFocus? focus)
    {
        if (Disabled) return;
        if (_open)
        {
            if (focus is { } edge && Context.FocusEdge is { } move) await move(edge);
            return;
        }
        if (Parent.OpenSub is { } sibling && sibling != this) await sibling.CloseAsync();
        Parent.OpenSub = this;
        _open = true;
        Context.PendingFocus = focus;
        Context.NotifyStateChanged();
        Parent.NotifyStateChanged();
    }

    internal async Task CloseAsync(bool dismissed = false)
    {
        if (!_open) return;
        if (Context.OpenSub is { } child) await child.CloseAsync();
        _open = false;
        Context.Active = null;
        if (Parent.OpenSub == this) Parent.OpenSub = null;
        Context.NotifyStateChanged();
        Parent.NotifyStateChanged();
    }

    internal Task CloseAllAsync() => Parent.Owner.CloseAllAsync();

    Task IMenuOwner.OpenAsync(Menu.MenuFocus? focus) => OpenAsync(focus);
    Task IMenuOwner.CloseAsync(bool dismissed) => CloseAsync(dismissed);
    Task IMenuOwner.CloseAllAsync() => CloseAllAsync();

    public void Dispose()
    {
        if (Parent?.OpenSub == this) Parent.OpenSub = null;
    }
}
