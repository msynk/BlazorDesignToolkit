@namespace BlazorDesignToolkit.Primitives
@* WAI-ARIA Tree View (single selection). Only one treeitem is in the tab sequence. Up/Down move between visible
   items; Right expands a closed parent or moves to its first child; Left collapses an open parent or moves to the
   parent; Home/End; Enter/Space select; * expands all siblings; type-to-select. aria-level, aria-setsize and
   aria-posinset are rendered explicitly. Give the tree an accessible name with aria-label or aria-labelledby.
   Virtualize renders the visible rows as a flat list of treeitems (allowed by ARIA when aria-level, aria-setsize and
   aria-posinset are present) and only those in view; the tree must be the scroll container. Because rows come and go
   while scrolling, focus then stays on the tree and the active row is exposed with aria-activedescendant (data-highlighted).
   Indent rows with the --bdt-tree-level custom property. *@
@using Microsoft.AspNetCore.Components.Web.Virtualization
@typeparam TItem where TItem : notnull
@inherits PrimitiveBase

<ul role="tree" @ref="_element"
    @attributes='Attributes("role", "tabindex", "aria-activedescendant")'
    tabindex="@(Virtualize ? "0" : null)"
    aria-activedescendant="@(Virtualize && _hasFocus && TabStop is { } active ? _ids[active] : null)"
    @onfocus="OnTreeFocus"
    @onblur="() => _hasFocus = false"
    data-virtualized="@(Virtualize ? "" : null)"
    data-bdt-keys="ArrowUp ArrowDown ArrowLeft ArrowRight Home End PageUp PageDown Space"
    @onkeydown="OnKeyDownAsync">
    @if (Virtualize)
    {
        <Virtualize TItem="TItem" Items="_visible" ItemSize="ItemSize" OverscanCount="OverscanCount" Context="row">
            @RenderRow(row)
        </Virtualize>
    }
    else
    {
        @RenderLevel(Items ?? [], 1, default)
    }
</ul>

@code {
    private readonly Typeahead _typeahead = new();
    private readonly Dictionary<TItem, string> _ids = new();
    private readonly Dictionary<TItem, TItem?> _parents = new();
    private HashSet<TItem> _expanded = new();
    private List<TItem> _visible = [];
    private ElementReference _element;
    private TItem? _focused;
    private string _baseId = "";
    private string? _pendingFocusId;
    private bool _expandedInitialized;
    private readonly Dictionary<TItem, (int Level, int SetSize, int PosInSet)> _meta = new();
    private int _pendingScrollIndex = -1;

    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }
    [Parameter, EditorRequired] public Func<TItem, IEnumerable<TItem>?> ChildrenSelector { get; set; } = _ => null;
    [Parameter] public Func<TItem, string>? ItemLabel { get; set; }
    [Parameter] public Func<TItem, bool>? ItemDisabled { get; set; }
    [Parameter] public RenderFragment<TreeItemContext<TItem>>? ItemTemplate { get; set; }
    [Parameter] public TItem? Value { get; set; }
    [Parameter] public EventCallback<TItem?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyCollection<TItem>? ExpandedItems { get; set; }
    [Parameter] public EventCallback<IReadOnlyCollection<TItem>> ExpandedItemsChanged { get; set; }
    /// <summary>Render only the rows in view (for large trees). Requires a uniform <see cref="ItemSize"/>.</summary>
    [Parameter] public bool Virtualize { get; set; }
    /// <summary>Row height in CSS pixels when virtualized. Default 32.</summary>
    [Parameter] public float ItemSize { get; set; } = 32;
    [Parameter] public int OverscanCount { get; set; } = 5;
    /// <summary>Rows moved by Page Up/Page Down. Default 10.</summary>
    [Parameter] public int PageSize { get; set; } = 10;

    private string Label(TItem item) => ItemLabel?.Invoke(item) ?? item?.ToString() ?? "";
    private bool IsDisabled(TItem item) => ItemDisabled?.Invoke(item) == true;
    private IReadOnlyList<TItem> Children(TItem item) => ChildrenSelector(item)?.ToList() ?? [];

    protected override void OnInitialized() => _baseId = ProvidedId ?? Ids.Next("tree");

    protected override void OnParametersSet()
    {
        if (ExpandedItemsChanged.HasDelegate || !_expandedInitialized)
        {
            _expanded = new HashSet<TItem>(ExpandedItems ?? []);
            _expandedInitialized = true;
        }
        Index();
    }

    /// <summary>Builds parent links, stable ids and the list of visible items in document order.</summary>
    private void Index()
    {
        _visible = [];
        _parents.Clear();
        _meta.Clear();
        void Walk(IEnumerable<TItem> level, TItem? parent, int depth)
        {
            var list = level.ToList();
            for (var i = 0; i < list.Count; i++)
            {
                var item = list[i];
                _parents[item] = parent;
                _meta[item] = (depth, list.Count, i + 1);
                if (!_ids.ContainsKey(item)) _ids[item] = $"{_baseId}-item-{_ids.Count}";
                _visible.Add(item);
                if (_expanded.Contains(item)) Walk(Children(item), item, depth + 1);
            }
        }
        Walk(Items ?? [], default, 1);
        if (_focused is not null && !_visible.Contains(_focused)) _focused = default;
    }

    private TItem? TabStop => _focused ?? (Value is not null && _visible.Contains(Value) ? Value : _visible.FirstOrDefault(i => !IsDisabled(i)));

    private RenderFragment RenderLevel(IEnumerable<TItem> items, int level, TItem? parent) => builder =>
    {
        var list = items.ToList();
        var seq = 0;
        for (var i = 0; i < list.Count; i++)
        {
            var item = list[i];
            var children = Children(item);
            var hasChildren = children.Count > 0;
            var expanded = hasChildren && _expanded.Contains(item);
            var selected = Value is not null && EqualityComparer<TItem>.Default.Equals(Value, item);
            var disabled = IsDisabled(item);
            builder.OpenElement(seq++, "li");
            builder.SetKey(item);
            builder.AddAttribute(seq++, "role", "treeitem");
            builder.AddAttribute(seq++, "id", _ids[item]);
            builder.AddAttribute(seq++, "aria-level", level);
            builder.AddAttribute(seq++, "aria-setsize", list.Count);
            builder.AddAttribute(seq++, "aria-posinset", i + 1);
            if (hasChildren) builder.AddAttribute(seq++, "aria-expanded", expanded ? "true" : "false");
            builder.AddAttribute(seq++, "aria-selected", selected ? "true" : "false");
            if (disabled) builder.AddAttribute(seq++, "aria-disabled", "true");
            builder.AddAttribute(seq++, "tabindex", EqualityComparer<TItem?>.Default.Equals(TabStop, item) ? "0" : "-1");
            builder.AddAttribute(seq++, "data-state", expanded ? "open" : hasChildren ? "closed" : null);
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OnItemClickAsync(item)));
            builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
            builder.AddAttribute(seq++, "onfocus", EventCallback.Factory.Create(this, () => _focused = item));
            builder.AddEventStopPropagationAttribute(seq++, "onfocus", true);
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "data-tree-label", "");
            if (ItemTemplate is not null) builder.AddContent(seq++, ItemTemplate(new TreeItemContext<TItem>(item, level, Label(item), hasChildren, expanded, selected, disabled)));
            else builder.AddContent(seq++, Label(item));
            builder.CloseElement();
            if (expanded)
            {
                builder.OpenElement(seq++, "ul");
                builder.AddAttribute(seq++, "role", "group");
                builder.AddContent(seq++, RenderLevel(children, level + 1, item));
                builder.CloseElement();
            }
            builder.CloseElement();
        }
    };

    /// <summary>One row of the flat (virtualized) rendering.</summary>
    private RenderFragment RenderRow(TItem item) => builder =>
    {
        var (level, setSize, posInSet) = _meta[item];
        var hasChildren = Children(item).Count > 0;
        var expanded = hasChildren && _expanded.Contains(item);
        var selected = Value is not null && EqualityComparer<TItem>.Default.Equals(Value, item);
        var disabled = IsDisabled(item);
        builder.OpenElement(0, "li");
        builder.SetKey(item);
        builder.AddAttribute(1, "role", "treeitem");
        builder.AddAttribute(2, "id", _ids[item]);
        builder.AddAttribute(3, "aria-level", level);
        builder.AddAttribute(4, "aria-setsize", setSize);
        builder.AddAttribute(5, "aria-posinset", posInSet);
        if (hasChildren) builder.AddAttribute(6, "aria-expanded", expanded ? "true" : "false");
        builder.AddAttribute(7, "aria-selected", selected ? "true" : "false");
        if (disabled) builder.AddAttribute(8, "aria-disabled", "true");
        if (EqualityComparer<TItem?>.Default.Equals(TabStop, item)) builder.AddAttribute(9, "data-highlighted", "");
        builder.AddAttribute(10, "data-state", expanded ? "open" : hasChildren ? "closed" : null);
        builder.AddAttribute(11, "style", $"--bdt-tree-level: {level}");
        builder.AddAttribute(12, "onclick", EventCallback.Factory.Create(this, async () =>
        {
            await OnItemClickAsync(item);
            await _element.FocusAsync();
        }));
        builder.OpenElement(14, "span");
        builder.AddAttribute(15, "data-tree-label", "");
        if (ItemTemplate is not null) builder.AddContent(16, ItemTemplate(new TreeItemContext<TItem>(item, level, Label(item), hasChildren, expanded, selected, disabled)));
        else builder.AddContent(17, Label(item));
        builder.CloseElement();
        builder.CloseElement();
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Js.TrackAsync("preventKeys", _element);
        if (_pendingFocusId is { } id)
        {
            _pendingFocusId = null;
            if (Virtualize && _pendingScrollIndex >= 0)
            {
                // The active row may be outside the rendered range: scroll until Virtualize has rendered it (focus stays on the tree).
                var index = _pendingScrollIndex;
                _pendingScrollIndex = -1;
                await Js.InvokeVoidAsync("revealAndFocus", _element, index, ItemSize, id, 1500, false);
            }
            else
            {
                await Js.InvokeVoidAsync("focusById", id, false);
            }
        }
    }

    private async Task OnItemClickAsync(TItem item)
    {
        _focused = item;
        if (IsDisabled(item)) return;
        if (Children(item).Count > 0) await SetExpandedAsync(item, !_expanded.Contains(item));
        await SelectAsync(item);
    }

    private async Task SelectAsync(TItem item)
    {
        if (IsDisabled(item)) return;
        Value = item;
        await ValueChanged.InvokeAsync(item);
    }

    private async Task SetExpandedAsync(TItem item, bool expanded)
    {
        if (expanded ? !_expanded.Add(item) : !_expanded.Remove(item)) return;
        Index();

        if (ExpandedItemsChanged.HasDelegate) await ExpandedItemsChanged.InvokeAsync(_expanded.ToArray());
    }

    private bool _hasFocus;

    private void OnTreeFocus()
    {
        _hasFocus = true;
        if (Virtualize && _focused is null && TabStop is { } first) _focused = first;
    }

    private void FocusItem(TItem item)
    {
        _focused = item;
        _pendingFocusId = _ids[item];
        _pendingScrollIndex = _visible.IndexOf(item);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        var current = _focused ?? TabStop;
        if (current is null) return;
        var index = _visible.IndexOf(current);
        switch (e.Key)
        {
            case "ArrowDown":
            case "ArrowUp":
            case "Home":
            case "End":
                {
                    var intent = KeyboardNavigation.Intent(e.Key, Orientation.Vertical);
                    var next = KeyboardNavigation.Move(index, _visible.Count, i => IsDisabled(_visible[i]), intent, loop: false);
                    if (next >= 0 && next != index) FocusItem(_visible[next]);
                    return;
                }
            case "PageUp":
            case "PageDown":
                {
                    var target = Math.Clamp(index + (e.Key == "PageDown" ? PageSize : -PageSize), 0, _visible.Count - 1);
                    var step = e.Key == "PageDown" ? -1 : 1;
                    while (IsDisabled(_visible[target]) && target != index) target += step;
                    if (target != index) FocusItem(_visible[target]);
                    return;
                }
            case "ArrowRight":
                if (Children(current).Count == 0) return;
                if (!_expanded.Contains(current)) await SetExpandedAsync(current, true);
                else if (Children(current).FirstOrDefault() is { } first) FocusItem(first);
                return;
            case "ArrowLeft":
                if (_expanded.Contains(current)) await SetExpandedAsync(current, false);
                else if (_parents.GetValueOrDefault(current) is { } parent) FocusItem(parent);
                return;
            case "Enter":
            case " ":
                await SelectAsync(current);
                return;
            case "*":
                {
                    var siblings = _parents.GetValueOrDefault(current) is { } p ? Children(p) : (Items ?? []).ToList();
                    foreach (var s in siblings.Where(s => Children(s).Count > 0)) _expanded.Add(s);
                    Index();
                    if (ExpandedItemsChanged.HasDelegate) await ExpandedItemsChanged.InvokeAsync(_expanded.ToArray());
                    return;
                }
        }
        if (KeyboardNavigation.IsPrintable(e))
        {
            var match = _typeahead.Search(e.Key[0], index, _visible.Select(Label).ToList(), i => IsDisabled(_visible[i]));
            if (match >= 0 && match != index) FocusItem(_visible[match]);
        }
    }
}
