@namespace BlazorDesignToolkit.Primitives
@* Native checkbox (<input type="checkbox">), which already provides the correct role, states and Space activation.
   Adds controlled/uncontrolled state, the indeterminate ("mixed") state (a DOM property that only JavaScript can set)
   and FormField wiring. Associate a label with <FormLabel> or a wrapping <label>.
   @bind:get/@bind:set (rather than checked + @onchange) lets the renderer track the state the browser already shows,
   so a controlled checkbox whose change is rejected is rendered back to its real state. *@
@inherits PrimitiveBase

<input type="checkbox" @ref="_element"
       @attributes='Attributes("type", "checked")'
       id="@(Field?.ControlId ?? ProvidedId)"
       disabled="@(Disabled || Field?.Disabled == true)"
       required="@(Required || Field?.Required == true)"
       name="@Name"
       value="@Value"
       aria-describedby="@Field?.DescribedBy"
       aria-invalid="@(Field?.Invalid == true ? "true" : null)"
       aria-errormessage="@(Field is { Invalid: true, HasError: true } ? Field.ErrorId : null)"
       data-state="@(Indeterminate ? "indeterminate" : Current ? "checked" : "unchecked")"
       @bind:get="Current" @bind:set="OnChangeAsync" />

@code {
    private readonly Controllable<bool> _checked = new(false);
    private ElementReference _element;
    private bool? _appliedIndeterminate;

    [CascadingParameter] private FormFieldContext? Field { get; set; }
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool DefaultChecked { get; set; }
    /// <summary>Shows the mixed state. Cleared by the browser when the user toggles; raise <see cref="CheckedChanged"/> handlers accordingly.</summary>
    [Parameter] public bool Indeterminate { get; set; }
    [Parameter] public EventCallback<bool> IndeterminateChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Value { get; set; }

    private bool Controlled => CheckedChanged.HasDelegate;
    private bool Current => _checked.Get(Checked, Controlled);

    protected override void OnInitialized()
    {
        _checked.Initialize(DefaultChecked || Checked);
        TrackField(Field);
    }

    protected override void OnParametersSet() => _checked.Sync(Checked, IsProvided(nameof(Checked)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_appliedIndeterminate != Indeterminate)
        {
            _appliedIndeterminate = Indeterminate;
            await Js.InvokeVoidAsync("setIndeterminate", _element, Indeterminate);
        }
    }

    private async Task OnChangeAsync(bool value)
    {
        if (Indeterminate && IndeterminateChanged.HasDelegate) await IndeterminateChanged.InvokeAsync(false);
        await _checked.SetAsync(value, Controlled, CheckedChanged);
    }
}
