{
  "dimension": { "$type": "dimension", "small": { "$value": { "value": 8, "unit": "px" } }, "rem": { "$value": { "value": 0.5, "unit": "rem" } }, "zero": { "$value": { "value": 0, "unit": "px" } } },
  "font": {
    "single": { "$type": "fontFamily", "$value": "Comic Sans MS" },
    "stack": { "$type": "fontFamily", "$value": ["Helvetica", "Arial", "sans-serif"] },
    "weight-number": { "$type": "fontWeight", "$value": 350 },
    "weight-keyword": { "$type": "fontWeight", "$value": "extra-black" }
  },
  "duration": { "$type": "duration", "quick": { "$value": { "value": 100, "unit": "ms" } }, "long": { "$value": { "value": 1.5, "unit": "s" } } },
  "easing": { "$type": "cubicBezier", "accelerate": { "$value": [0.5, 0, 1, 1] }, "overshoot": { "$value": [0.3, -0.5, 0.7, 1.5] } },
  "number": { "$type": "number", "ratio": { "$value": 1.618 } },
  "stroke": {
    "$type": "strokeStyle",
    "keyword": { "$value": "dashed" },
    "object": { "$value": { "dashArray": [{ "value": 0.5, "unit": "rem" }, "{dimension.small}"], "lineCap": "round" } }
  },
  "border": {
    "heavy": {
      "$type": "border",
      "$value": { "color": "{color.ink}", "width": { "value": 3, "unit": "px" }, "style": "{stroke.keyword}" }
    }
  },
  "color": { "ink": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1, 0.1, 0.1] } } },
  "transition": {
    "emphasis": {
      "$type": "transition",
      "$value": { "duration": { "value": 200, "unit": "ms" }, "delay": { "value": 0, "unit": "ms" }, "timingFunction": "{easing.accelerate}" }
    }
  },
  "shadow": {
    "layered": {
      "$type": "shadow",
      "$value": [
        { "color": "{color.ink}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
        { "color": "{color.ink}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 4, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "inset": true }
      ]
    }
  },
  "gradient": {
    "sunset": {
      "$type": "gradient",
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [1, 0.5, 0] }, "position": 0 },
        { "color": "{color.ink}", "position": "{number-half}" }
      ]
    }
  },
  "typography": {
    "heading": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.stack}", "fontSize": { "value": 2, "unit": "rem" }, "fontWeight": "{font.weight-keyword}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.2 }
    }
  },
  "number-half": { "$type": "number", "$value": 0.5 }
}
